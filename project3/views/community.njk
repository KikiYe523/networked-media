<html>

<head>
    <title>Community wall · Nice to “Climb” You NYC</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="/style.css" rel="stylesheet">

</head>

<body>
<header>
    <a class="wordmark" href="/">Nice to “Climb” You NYC</a>
    <nav>
        <a href="/">Make a Card</a>
        <a href="/community">Community wall</a>
    </nav>
</header>
<main class="community-page">

        <h1>Community wall</h1>

        <a class="button" href="/make-card">Create your card ↗</a>

        <form class="gym-filter" method="POST" action="/filter-cards">
            <label>Find cards by home gym<select name="gym">
                    <option value="">All gyms</option>{% include "partial-gym-options.njk" %}
                </select></label>
            <button type="submit">Apply filter</button><a class="text-link" href="/community">Clear filter</a>
        </form>
        {% if cards.length == 0 %}
        <p class="empty-wall">{% if selectedGym %}No cards from this gym yet.{% else %}No cards yet. Add the first
            one.{% endif %}</p>
        {% endif %}
        <section class="cards">
            {# the server already chose which cards match the gymtThis loop only
   displays them, using the same content aes the preview. giltering changes
   this list, not the array holding everyone's submissions. #}
            {% for card in cards %}
            <article class="card background-{{ card.background }}">
                {% include "partial-card.njk" %}
            </article>
            {% endfor %}
        </section>

    </main>
</body>

</html>